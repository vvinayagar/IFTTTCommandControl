<Window x:Class="CommandControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommandControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Credential" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label Content="Username" HorizontalAlignment="Left" Margin="42,118,0,0" VerticalAlignment="Top"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="42,163,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtUsername" HorizontalAlignment="Left" Margin="117,126,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="117,171,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Key" HorizontalAlignment="Left" Margin="42,265,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtKey" HorizontalAlignment="Left" Margin="117,273,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="btnSave" Content="Save" HorizontalAlignment="Left" Margin="42,395,0,0" VerticalAlignment="Top" RenderTransformOrigin="0,1.054" Click="Button_Click"/>
        <Button x:Name="btnTest" Content="Test File" HorizontalAlignment="Left" Margin="282,272,0,0" VerticalAlignment="Top" Click="btnTest_Click"/>
        <ListBox x:Name="lsLogs" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="486,0,0,0"/>
        <Button x:Name="btnDetails" Content="List Details" HorizontalAlignment="Left" Margin="282,307,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.076,0.403" Click="Button_Click_1"/>
        <Button x:Name="btnTimer" Content="Start Service" HorizontalAlignment="Left" Margin="412,0,0,9" VerticalAlignment="Bottom" Click="btnTimer_Click"/>

    </Grid>
</Window>
